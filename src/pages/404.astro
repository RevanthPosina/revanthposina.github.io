---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found | Revanth Posina" description="This page has not landed yet." noindex>
  <div class="frame">
    <main class="nf">
      <span class="code">404 // partition not found</span>
      <div class="late" aria-hidden="true"><i style="height:38px"></i><i style="height:52px"></i><i style="height:44px"></i><i style="height:60px"></i><i class="miss" style="height:56px"></i><i style="height:48px"></i></div>
      <h1>This page is late-arriving data.</h1>
      <p>It never landed, or it moved. Everything that did land is on the home page.</p>
      <div class="btns"><a class="btn btn-dark" href="/">Go to the home page</a></div>
    </main>
  </div>
</Base>
