---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import { profile } from '../data/content.js';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = `${profile.name} | ${profile.title} at ${profile.employer}`,
  description = profile.description,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = new URL('/og.png', Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.title,
  worksFor: { '@type': 'Organization', name: profile.employer },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Indiana University Bloomington' },
  address: { '@type': 'PostalAddress', addressRegion: 'WA', addressCountry: 'US' },
  url: profile.url,
  image: new URL('/images/portrait.jpg', Astro.site).href,
  sameAs: [profile.links.github, profile.links.linkedin, profile.links.medium],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#FAFAFA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090B" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Revanth Posina, Data Engineer (AI/ML) at Microsoft" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline>
      try { var t = localStorage.getItem('theme'); if (t === 'dark' || t === 'light') document.documentElement.setAttribute('data-theme', t); } catch (e) {}
    </script>
  </head>
  <body>
    <Icons />
    <slot />
  </body>
</html>
